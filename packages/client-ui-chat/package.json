{
  "name": "@everywhere-harness/client-ui-chat",
  "version": "0.1.0",
  "description": "Everywhere Harness visual identity for the chat and sidebar",
  "type": "module",
  "license": "MIT",
  "publishConfig": { "access": "public" },
  "engines": { "node": ">=24.9.0" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/everson-junior/everywhere-makertplace-harness.git",
    "directory": "packages/client-ui-chat"
  },
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./client": { "types": "./lib/types/client/index.d.ts", "default": "./lib/client.js" },
    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml", "README.md", "LICENSE"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:pack": "node scripts/pack-smoke.mjs",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm run typecheck && pnpm run build && pnpm run test"
  },
  "peerDependencies": { "@deepseek-ai/cordis": "4.0.5" },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-api-session-controller": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-store": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-chat": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-session": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.3",
    "@types/node": "24.10.0",
    "@types/react": "18.3.27",
    "esbuild": "0.25.12",
    "jsdom": "27.2.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.9.3"
  }
}